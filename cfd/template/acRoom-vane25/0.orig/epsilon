FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 0.262;

boundaryField
{
    walls
    {
        type            epsilonWallFunction;
        value           $internalField;
    }

    inletXp
    {
        type            turbulentMixingLengthDissipationRateInlet;
        mixingLength    0.0060;
        value           $internalField;
    }

    inletXm
    {
        type            turbulentMixingLengthDissipationRateInlet;
        mixingLength    0.0060;
        value           $internalField;
    }

    inletYp
    {
        type            turbulentMixingLengthDissipationRateInlet;
        mixingLength    0.0060;
        value           $internalField;
    }

    inletYm
    {
        type            turbulentMixingLengthDissipationRateInlet;
        mixingLength    0.0060;
        value           $internalField;
    }

    return
    {
        type            inletOutlet;
        inletValue      $internalField;
    }
}


